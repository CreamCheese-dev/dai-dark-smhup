pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include update.lua
#include draw.lua

function _init()
	-- clear screen
	cls(0)
	mode="start"
end

function draw_start()
	cls(1)
	print("dai dark",50,33,rnd(16))
	print("press any key to begin",23,53,rnd(16))
end

function _update()
	if mode == "game" then
		update_game()
	elseif mode == "start" then
		update_start()
	end
	
end


function _draw()
	if mode == "game" then
		draw_game()
	elseif mode == "start" then
		draw_start()
	end
end

function start_game()
	mode="game"
	-- ship pos
	xpos=63
	ypos=63
	-- ship spr
	spr_id=1
	flame=4
	muzzle=0
	-- bullet
	bulletspr=16
	buly=-10
	bspeed=3
	--ui
	score=0
	lives=3
	bombs=4
	-- background star pos
	gen_star_pos()
end

function gen_star_pos()
	star_x={}
	star_y={}
	star_spd={}
	for i=1, 100 do
		add(star_x, rnd(128))
		add(star_y, rnd(128))
		add(star_spd, rnd(1.5)+0.5)
	end
end

function starfield()
	for i=1,#star_x do
		local scol = 6

		if star_spd[i] < 1 then
			scol = 1
		elseif star_spd[i] >= 1.5 then
			scol = rnd(16)
		end

		pset(star_x[i], star_y[i], scol)
		star_y[i]+=star_spd[i]

		if star_y[i] >= 128 then
			star_y[i]=0
		end

	end	
end
